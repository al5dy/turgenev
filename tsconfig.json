{
	"compilerOptions": {
		"target": "ES2020",
		"lib": [ "ES2020", "ES2022.Array", "DOM" ],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true
	},
	"include": [ "resources/ts" ]
}
