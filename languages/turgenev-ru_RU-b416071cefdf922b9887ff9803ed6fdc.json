            ],
            "Turgenev is ready, but an API key has not been configured yet.": [
                "\u0422\u0443\u0440\u0433\u0435\u043d\u0435\u0432 \u0433\u043e\u0442\u043e\u0432 \u043a \u0440\u0430\u0431\u043e\u0442\u0435, \u043d\u043e \u043a\u043b\u044e\u0447 API \u0435\u0449\u0451 \u043d\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d."
