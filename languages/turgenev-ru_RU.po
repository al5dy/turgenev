msgstr "Запросы"

#: src/I18n/ReportGlossary.php:74
msgctxt "Turgenev report"
msgid "Exact-match keywords"
msgstr "Запросы в точной форме"

#: src/I18n/ReportGlossary.php:75
msgctxt "Turgenev report"
msgid "Long sentences"
msgstr "Длинные предложения"

#: src/I18n/ReportGlossary.php:76
msgctxt "Turgenev report"
msgid "Long words"
msgstr "Длинные слова"

#: src/I18n/ReportGlossary.php:79
msgctxt "Turgenev report"
msgid "Long sentence"
msgstr "Длинное предложение"

#: src/I18n/ReportGlossary.php:80
msgctxt "Turgenev report"
msgid "Contains long words"
msgstr "Наличие длинных слов"

#: src/I18n/ReportGlossary.php:81
msgctxt "Turgenev report"
