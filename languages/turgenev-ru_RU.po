#: src/I18n/ReportGlossary.php:29
msgctxt "Turgenev report"
msgid "minimal"
msgstr "минимальный"

#: src/I18n/ReportGlossary.php:30
msgctxt "Turgenev report"
msgid "low"
msgstr "низкий"

#: src/I18n/ReportGlossary.php:31
msgctxt "Turgenev report"
msgid "medium"
msgstr "средний"

#: src/I18n/ReportGlossary.php:32
msgctxt "Turgenev report"
msgid "high"
msgstr "высокий"

#: src/I18n/ReportGlossary.php:33
msgctxt "Turgenev report"
msgid "critical"
msgstr "критический"

#: src/I18n/ReportGlossary.php:36
msgctxt "Turgenev report"
msgid "“Academic nausea”"
msgstr "«Академическая тошнота»"

#: src/I18n/ReportGlossary.php:37
msgctxt "Turgenev report"
msgid "“Classic nausea”"
msgstr "«Классическая тошнота»"

#: src/I18n/ReportGlossary.php:38
msgctxt "Turgenev report"
msgid "Phrase “nausea”"
msgstr "«Тошнота» словосочетаний"

#: src/I18n/ReportGlossary.php:39
msgctxt "Turgenev report"
msgid "Water content"
msgstr "Водность"

#: src/I18n/ReportGlossary.php:40
msgctxt "Turgenev report"
msgid "Share of meaningful text"
msgstr "Доля содержательного текста"

#: src/I18n/ReportGlossary.php:41
msgctxt "Turgenev report"
msgid "Readability index"
msgstr "Индекс удобочитаемости"

#: src/I18n/ReportGlossary.php:42
msgctxt "Turgenev report"
msgid "Number of style problems"
msgstr "Количество стилистических проблем"

#: src/I18n/ReportGlossary.php:43
msgctxt "Turgenev report"
msgid "Style problem density"
msgstr "Плотность стилистических проблем"

#: src/I18n/ReportGlossary.php:44
msgctxt "Turgenev report"
msgid "Keyword coverage"
msgstr "Покрытие ключевыми словами"

#: src/I18n/ReportGlossary.php:45
msgctxt "Turgenev report"
msgid "Overuse of “и” (“and”)"
msgstr "Сверхконцентрация «и»"

#: src/I18n/ReportGlossary.php:46
msgctxt "Turgenev report"
msgid "Overly frequent words"
msgstr "Сверхчастые слова"

#: src/I18n/ReportGlossary.php:49
msgctxt "Turgenev report"
msgid "“Academic nausea” calculated for pairs of words (possibly with a preposition between them) rather than for single words. The more phrases repeat, the higher it is."
msgstr "\"Академическая тошнота\", посчитанная не для отдельных слов, а для пар слов (между которыми может быть предлог). Она тем выше, чем больше повторов словосочетаний."

#: src/I18n/ReportGlossary.php:50
msgctxt "Turgenev report"
msgid "The share of words in the text that are on neither the stop-word nor the common-word list."
msgstr "Доля в тексте слов, не входящих в списки стоп-слов и общих слов."

#: src/I18n/ReportGlossary.php:51
msgctxt "Turgenev report"
msgid "The share of stop words in the text. Not used to determine the risk."
msgstr "Доля стоп-слов в тексте. Для определения риска не используется."

#: src/I18n/ReportGlossary.php:52
msgctxt "Turgenev report"
msgid "The share of the text taken up by search queries (including “penalties” for exact-match and long queries)."
msgstr "Доля текста, которую занимают запросы (с учетом «штрафов» за запросы в точной форме и длинные запросы)."

#: src/I18n/ReportGlossary.php:53
msgctxt "Turgenev report"
msgid "An index that rates how hard a text is to read from its average word and sentence lengths: the Automated Readability Index, adapted for Russian."
msgstr "Индекс, оценивающий сложность текста на основе средних длин слов и предложений. Automated Readability Index в варианте, адаптированном для русского языка."

#: src/I18n/ReportGlossary.php:54
msgctxt "Turgenev report"
msgid "The number of words that occur in the text significantly more often than a probabilistic model predicts."
msgstr "Количество слов, которые встречаются в тексте существенно чаще, чем должны были в соответствии с вероятностной моделью."

#: src/I18n/ReportGlossary.php:55
msgctxt "Turgenev report"
msgid "The number of style problems divided by the length of the text in words."
msgstr "Количество стилистических проблем, деленное на длину текста в словах."

#: src/I18n/ReportGlossary.php:56
msgctxt "Turgenev report"
msgid "A parameter that depends on the highest word frequency in the text. Not used to determine the risk."
msgstr "Параметр, зависящий от максимальной частоты слов в тексте. Для определения риска не используется."

#: src/I18n/ReportGlossary.php:57
msgctxt "Turgenev report"
msgid "A parameter that rates how much words repeat in the text. The more often a word repeats, the more it contributes."
msgstr "Параметр, оценивающий количество повторов слов в тексте. Чем чаще слово повторяется, тем больше его вклад."

#: src/I18n/ReportGlossary.php:58
msgctxt "Turgenev report"
msgid "Too many repetitions of the conjunction “и” (“and”). May point to overuse of constructions like «удобно и выгодно» (“convenient and profitable”)."
msgstr "Слишком большое количество повторов союза «и». Может свидетельствовать о злоупотреблении конструкциями типа «удобно и выгодно»."

#: src/I18n/ReportGlossary.php:59
msgctxt "Turgenev report"
msgid "The sum of the “quanta” (from 1 to 3) the words of the text received for style problems."
msgstr "Сумма «квантов» (от 1 до 3), полученных словами текста за стилистические проблемы."

#: src/I18n/ReportGlossary.php:62
msgctxt "Turgenev report"
msgid "No"
msgstr "Нет"

#: src/I18n/ReportGlossary.php:65
msgctxt "Turgenev report"
msgid "There are problems. Editing is advisable."
msgstr "Есть проблемы. Желательно отредактировать."

#: src/I18n/ReportGlossary.php:66
msgctxt "Turgenev report"
msgid "Many problems. Editing or rewriting is advisable."
msgstr "Много проблем. Желательно отредактировать или переписать."

#: src/I18n/ReportGlossary.php:67
msgctxt "Turgenev report"
msgid "Very many problems. Rewriting is advisable."
msgstr "Очень много проблем. Желательно переписать."

#: src/I18n/ReportGlossary.php:68
msgctxt "Turgenev report"
msgid "Potential style problems — it may well be fine."
msgstr "Потенциальные стилистические проблемы — возможно, всё ОК."

#: src/I18n/ReportGlossary.php:69
msgctxt "Turgenev report"
msgid "Almost certainly a problem. Editing is advisable."
msgstr "Проблема почти точно есть. Желательно отредактировать."

#: src/I18n/ReportGlossary.php:70
msgctxt "Turgenev report"
msgid "A serious problem. Fix it."
msgstr "Серьезная проблема. Исправьте."

#: src/I18n/ReportGlossary.php:71
msgctxt "Turgenev report"
msgid "Common (“empty”) words"
msgstr "Общие (\"пустые\") слова"

#: src/I18n/ReportGlossary.php:72
