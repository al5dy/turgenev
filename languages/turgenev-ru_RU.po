msgstr "покрытие точными запросами"

#: src/I18n/ReportGlossary.php:88
msgctxt "Turgenev report"
msgid "long keywords"
msgstr "длинные запросы"

#. translators: %s: comma-separated words from the analyzed text, left in their original language.
